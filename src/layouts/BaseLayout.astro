---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  home?: boolean;
}

const {
  title = "Golden Wings",
  description = "Golden Wings / Fifty Year Flight Path. A documentary about flight attendants and one American Airlines family, told across three generations.",
  canonical,
  home = false,
} = Astro.props;

const pageTitle =
  title === "Golden Wings"
    ? "Golden Wings / Fifty Year Flight Path"
    : `${title} · Golden Wings`;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/film", label: "Film" },
  { href: "/about-the-film", label: "About" },
  { href: "/people", label: "People" },
  { href: "/indie-doc-journey", label: "Journey" },
  { href: "/contact", label: "Contact" },
];

function isCurrent(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Condensed:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ "is-home": home }]}>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <span class="brand__primary">Golden Wings</span>
          <span class="brand__sub">Fifty Year Flight Path</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="nav-cta"
                href="https://gwingz.com"
                rel="noopener noreferrer"
                >Watch</a
              >
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class:list={["site-main", { "site-main--home": home }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__title">Golden Wings</p>
          <p class="site-footer__sub">Fifty Year Flight Path</p>
          <p class="site-footer__copy">
            © 2026 Get Booked Studio / Gwingz
          </p>
        </div>
        <nav aria-label="Contact and legal" class="site-footer__nav">
          <a href="mailto:caleb@golden-wings-robyn.com">caleb@golden-wings-robyn.com</a>
          <a href="mailto:info@golden-wings-robyn.com">info@golden-wings-robyn.com</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-of-use">Terms</a>
          <a href="/optin">SMS Opt-In</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
