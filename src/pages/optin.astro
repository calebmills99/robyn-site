---
import BaseLayout from "../layouts/BaseLayout.astro";
import { webPageJsonLd } from "../lib/seo";
import { watchUrl } from "../lib/funnel";

const description =
  "Find Your Wings. Leave your email, watch the first cut of Golden Wings free, and hear first when the Kickstarter opens.";
---

<BaseLayout
  title="Sign Up"
  description={description}
  jsonLd={webPageJsonLd({
    name: "Sign Up",
    description,
    url: "/optin",
  })}
>
  <section class="optin-box">
    <h1 class="section__title">Join the list</h1>
    <p class="script page-motto">Find Your Wings</p>
    <p class="prose">
      Leave your email on our screening page and we will send you a link to
      watch the first cut of Golden Wings at home, free. It is the early,
      award-winning version, not the new feature, which stays under wraps until
      its festival premiere. You will also hear first when our Kickstarter
      opens. Rather just write us? info@golden-wings-robyn.com reaches a real
      person.
    </p>
    <div class="hero__ctas" style="margin-top: 1.75rem;">
      <a class="btn btn--primary" href={watchUrl("optin")} rel="noopener noreferrer"
        >Send me the link</a
      >
      <a class="btn btn--ghost" href="mailto:info@golden-wings-robyn.com"
        >Email us</a
      >
    </div>

    <div class="prose" style="margin-top: 2.5rem;">
      <h2>SMS updates</h2>
      <p>
        If you opt in to texts from Golden Wings, you consent to receive
        automated messages about screenings and special events at the number you
        provide. Message frequency may vary. Message and data rates may apply.
      </p>
      <ul>
        <li>Reply STOP to cancel anytime.</li>
        <li>Reply HELP or call 562-523-9620 for help.</li>
        <li>
          We do not sell your information. See our
          <a href="/privacy-policy">Privacy Policy</a> and
          <a href="/terms-of-use">Terms of Use</a>.
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
