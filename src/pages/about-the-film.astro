---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import { aboutPageJsonLd } from "../lib/seo";

const entry = await getEntry("pages", "about-the-film");
if (!entry) throw new Error("Missing content: pages/about-the-film");
const { Content } = await render(entry);

const description =
  entry.data.description || "About Golden Wings, the documentary.";
---

<BaseLayout
  title={entry.data.title}
  description={description}
  jsonLd={aboutPageJsonLd(description)}
>
  <header>
    <h1 class="section__title">{entry.data.title}</h1>
    <p class="script page-motto">Find Your Wings</p>
  </header>
  <article class="prose prose--drop-lead-title">
    <Content />
  </article>
  <div class="hero__ctas" style="margin-top: 2.5rem;">
    <a class="btn btn--primary" href="/people">Meet the people</a>
    <a class="btn btn--ghost" href="/contact">Contact</a>
  </div>
</BaseLayout>
