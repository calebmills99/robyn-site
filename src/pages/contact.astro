---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactPageJsonLd } from "../lib/seo";
import ScreeningsCard from "../components/ScreeningsCard.astro";

const description = "Contact Golden Wings — press, former crew, and everything else.";
---

<BaseLayout
  title="Contact"
  description={description}
  jsonLd={contactPageJsonLd(description)}
>
  <section class="contact-panel">
    <p class="section__label plate--subtitle">Get in touch</p>
    <h1 class="section__title">Contact</h1>
    <p class="script page-motto">Find Your Wings</p>

    <div class="contact-audiences" role="list">
      <div class="crew-row" role="listitem">
        <span>Press &amp; festivals</span>
        <span
          ><a href="mailto:caleb@golden-wings-robyn.com"
            >caleb@golden-wings-robyn.com</a
          ></span
        >
      </div>
      <div class="crew-row" role="listitem">
        <span>Former crew &amp; families</span>
        <span><a href="/#crew">Share your story</a></span>
      </div>
      <p class="contact-audiences__hint">
        Tell us your airline, your years, and one thing nobody believes about
        the job.
      </p>
      <div class="crew-row" role="listitem">
        <span>Everything else</span>
        <span
          ><a href="mailto:info@golden-wings-robyn.com"
            >info@golden-wings-robyn.com</a
          ></span
        >
      </div>
    </div>

    <p style="margin: 1.5rem 0;">
      <a class="mailto" href="mailto:caleb@golden-wings-robyn.com"
        >caleb@golden-wings-robyn.com</a
      >
    </p>
    <p style="margin: 0 0 1.5rem;">
      <a class="mailto" href="mailto:info@golden-wings-robyn.com"
        >info@golden-wings-robyn.com</a
      >
    </p>
    <p style="color: var(--text-muted); font-size: var(--fs-md);">
      Prefer a form? Use your mail client — this staging build uses mailto so
      nothing gets lost in a half-wired backend.
    </p>
    <div class="hero__ctas" style="margin-top: 2rem;">
      <a class="btn btn--primary" href="mailto:caleb@golden-wings-robyn.com"
        >Email Caleb</a
      >
      <a class="btn btn--ghost" href="https://gwingz.com" rel="noopener noreferrer"
        >Find a screening</a
      >
    </div>

    <div style="margin-top: var(--sp-7); max-width: 28rem;">
      <ScreeningsCard />
    </div>
  </section>
</BaseLayout>
