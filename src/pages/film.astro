---
import BaseLayout from "../layouts/BaseLayout.astro";
import { movieJsonLd } from "../lib/seo";

const description =
  "Golden Wings is a documentary about Robyn Stewart's 55-year American Airlines career and the family history around it.";
const posterSrc = "/images/poster/GWSSQ_Poster_2026.png";
---

<BaseLayout
  title="Film"
  description={description}
  ogType="video.other"
  ogImage={posterSrc}
  jsonLd={movieJsonLd(description, posterSrc)}
>
  <section class="hero" aria-label="Film">
    <p class="section__label">Golden Wings</p>
    <h1 class="hero__headline">Golden Wings: Stewardess to Sky Queen</h1>
    <p class="hero__lede">
      A documentary about Robyn Stewart, her 55 years at American Airlines, and
      the family history around the job.
    </p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="/about-the-film">About the film</a>
      <a class="btn btn--ghost" href="/people">Meet the people</a>
    </div>
  </section>

  <section class="section">
    <p class="section__label plate--subtitle">Synopsis</p>
    <h2 class="section__title">The story</h2>
    <div class="prose">
      <p>
        From stewardess college to the 747 rollout, 9/11, sobriety, and loss,
        Golden Wings follows one American Airlines family across three
        generations.
      </p>
      <p>
        Robyn Stewart has flown for American Airlines since 1971. Her son Caleb
        directed the film. Her father, Jay R. Ricks, helped build the airline's
        747 training program. Jock Bethune, an American Airlines media
        production specialist, appears on camera.
      </p>
    </div>
  </section>
</BaseLayout>
