---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeJsonLd } from "../lib/seo";

const description =
  "Golden Wings, a vivid documentary following flight attendant Robyn Stewart's 55-year legacy of resilience, family, and flight, told by her son Caleb.";

const year = new Date().getFullYear();

const posterSrc = "/images/poster/GWSSQ_Poster_2026.png";

const laurels = [
  {
    src: "/images/laurels/Clown_International_BEST_DOCUMENTARY_SHORT_2024.png",
    alt: "Clown International Film Festival - Best Documentary Short",
  },
  {
    src: "/images/laurels/Laurel_BEST_MOBILE_SHORT_-_Independent_Shorts_Awards_-_2024.png",
    alt: "Independent Shorts Awards - Best Mobile Short",
  },
  {
    src: "/images/laurels/Laurel_BEST_SHORT_CINEMATOGRAPHY_SILICON_BEACH.png",
    alt: "Silicon Beach Film Festival - Best Short Cinematography",
  },
  {
    src: "/images/laurels/Laurel_MAGIC_FANCY_DIRECTOR.png",
    alt: "Magic Silver Screen - Best First Time Director",
  },
  {
    src: "/images/laurels/BEST_DOCUMENTARY_SHORT_-_IGFA_-_International_Guadalajara_Film_Awards_-_2024.png",
    alt: "IGFA International Guadalajara Film Awards - Best Documentary Short",
  },
];
---

<BaseLayout title="Golden Wings" description={description} jsonLd={homeJsonLd(description)}>
  <section class="hero full-bleed-home" aria-label="Golden Wings">
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/synth-media/747-synth-broll-reel-poster.jpg"
      >
        <source
          src="/videos/synth-media/747-synth-broll-reel.mp4"
          type="video/mp4"
        />
      </video>
      <img
        class="hero__poster"
        src="/images/synth-media/747-synth-broll-reel-poster.jpg"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content">
      <p class="hero__brand-mark">
        <img
          src="/images/title-logo.png"
          alt="Golden Wings"
          width="900"
          height="360"
        />
      </p>
      <p class="script hero__motto">Find Your Wings</p>
      <h1 class="hero__headline">
        <span class="hero__headline-line"
          >1971: Robyn meets Destiny onboard the 747.</span
        >
        <span class="hero__headline-line"
          >{year}: Still flying. Now with golden wings.</span
        >
      </h1>
      <p class="hero__lede">
        The story of the 747 is more than just the tale of an aircraft. For my family, it became the backdrop for five decades of aviation history. Connecting Jay's groundbreaking work to Robyn's soaring career.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="https://gwingz.com" rel="noopener noreferrer"
          >Watch Golden Wings</a
        >
        <a class="btn btn--ghost" href="/people">Meet the people</a>
      </div>
    </div>
    <div class="hero__laurels award-strip" aria-label="Festival wins">
      {
        laurels.map((laurel) => (
          <img src={laurel.src} alt={laurel.alt} width="320" height="210" loading="lazy" />
        ))
      }
    </div>
    <div class="hero__wing" aria-hidden="true"></div>
  </section>

  <section class="section poster-plate full-bleed-home" aria-labelledby="poster-heading">
    <div class="poster-plate__inner">
      <div class="poster-plate__copy">
        <p class="section__label plate--subtitle">The film</p>
        <h2 id="poster-heading" class="section__title">Official poster</h2>
        <p class="poster-plate__lede">
          Stewardess to Sky Queen. The 2026 poster for Golden Wings.
        </p>
        <div class="hero__ctas">
          <a
            class="btn btn--primary"
            href={posterSrc}
            download="GWSSQ_Poster_2026.png"
            >Download poster</a
          >
          <a class="btn btn--ghost" href="https://gwingz.com" rel="noopener noreferrer"
            >Watch Golden Wings</a
          >
        </div>
      </div>
      <a
        class="poster-plate__frame"
        href={posterSrc}
        download="GWSSQ_Poster_2026.png"
        aria-label="Download the official Golden Wings Stewardess to Sky Queen poster"
      >
        <img
          class="poster-plate__img"
          src={posterSrc}
          alt="Official Golden Wings: Stewardess to Sky Queen poster, 2026"
          width="1083"
          height="1452"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <section class="section" aria-labelledby="story-heading">
    <p class="section__label plate--subtitle">The story</p>
    <h2 id="story-heading" class="section__title">Aviation history, family memory</h2>
    <div class="prose">
      <p>
        Golden Wings chronicles the evolution of commercial aviation through the
        life of Robyn Stewart, from the jet age to modern international routes,
        weaving archival footage, home video, and vérité moments into a portrait
        of professionalism, resilience, and the stubborn instinct to keep going.
      </p>
      <p>
        Shot as a micro-budget student project that grew into an award-winning
        short, the film has been recognized at festivals including the Swedish
        International Film Festival, Clown International, and Independent Shorts
        Awards.
      </p>
    </div>
    <div class="hero__ctas" style="margin-top: 2rem;">
      <a class="btn btn--primary" href="https://gwingz.com" rel="noopener noreferrer"
        >Watch on gwingz.com</a
      >
      <a class="btn btn--ghost" href="/indie-doc-journey">Indie Doc Journey</a>
    </div>
  </section>

  <section class="section" aria-labelledby="awards-heading">
    <p class="section__label plate--subtitle">Recognition</p>
    <h2 id="awards-heading" class="section__title">Selected awards</h2>
    <ul class="prose">
      <li>Swedish International Film Festival (2025): Best Documentary (Short)</li>
      <li>Clown International Film Festival: Best Documentary Short</li>
      <li>Independent Shorts Awards: Best Mobile Short</li>
      <li>Magic Silver Screen: Best First Time Director</li>
      <li>Silicon Beach Film Festival: Best Short Cinematography</li>
    </ul>
  </section>
</BaseLayout>
