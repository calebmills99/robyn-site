---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeJsonLd } from "../lib/seo";
import robynGrad1971 from "../assets/people/robyn-stewart-1971.jpg";
import ScreeningsCard from "../components/ScreeningsCard.astro";
      </div>
    </div>
  </section>

  <section class="cite-strip" aria-label="About this film">
    <p class="cite-strip__text">
      A documentary about flight attendants. A stewardess family memoir. Not a
      museum piece about airplanes.
    </p>
  </section>

  <section class="section section--story" id="story" aria-labelledby="story-heading">
    <div class="section__grid">
      <div class="section__copy">
        <p class="section__label">The story</p>
        <h2 id="story-heading" class="section__title">Cabin service since 1971</h2>
        <div class="prose">
          <p>
            Robyn Stewart joined American Airlines as a stewardess in 1971. She
            trained on the 747 and kept flying through the years that remade the
            job: weight checks, mergers, 9/11, and the long haul after.
          </p>
          <p>
            Her father, Jay R. Ricks, was an American Airlines flight engineer
            who helped build the airline's 747 training program. Jock Bethune,
            an AA media production specialist, appears on camera to remember that
            era from the hangar floor, not the cockpit.
          </p>
          <p>
            Directed by Robyn's son, Caleb Mills Stewart, the film stays with
            one family across three generations of American Airlines service.
          </p>
        </div>
      </div>
      <figure class="section__figure">
        <img
          src="/images/headshots/Jay_R_Ricks_and_Robyn2014.jpg"
          alt="Jay R. Ricks and Robyn Stewart with their dog, 2014"
          width="1600"
          height="1726"
          loading="lazy"
        />
        <figcaption>Jay R. Ricks and Robyn Stewart, 2014</figcaption>
      </figure>
    </div>
  </section>


  <section id="crew" class="section crew-call full-bleed-home band-dark" aria-labelledby="crew-heading">
    <div class="crew-call__inner">
      <div class="crew-call__copy">
        <p class="section__label">For the people who were there</p>
        <h2 id="crew-heading" class="section__title">You were there. That makes you the archive.</h2>
        <p class="crew-call__lede">
          Golden Wings is built from the memory of people who flew. If you worked a cabin, a cockpit, a ramp or a training room, we want your photographs and your stories. Some may end up in the film.
        </p>
      </div>

      <div class="crew-call__plate">
        <form class="crew-form" id="crew-form" action="/api/crew" method="post" novalidate>
          <div class="crew-form__field">
            <label class="crew-form__label" for="crew-name">Name</label>
            <input class="crew-form__input" id="crew-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="crew-form__field">
            <label class="crew-form__label" for="crew-email">Email</label>
            <input class="crew-form__input" id="crew-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="crew-form__field">
            <label class="crew-form__label" for="crew-airline-years">Airline &amp; years</label>
            <input class="crew-form__input" id="crew-airline-years" name="airline_years" type="text" placeholder="e.g. Delta 1997–2020" required />
          </div>
          <div class="crew-form__field">
            <label class="crew-form__label" for="crew-story">Your story</label>
            <textarea class="crew-form__textarea" id="crew-story" name="story" rows="5" placeholder="One thing nobody believes about the job." required></textarea>
          </div>
          <label class="crew-form__consent">
            <input id="crew-consent" name="consent" type="checkbox" value="yes" required />
            <span>Golden Wings may contact me and may use what I share in the film and on this site, with credit.</span>
          </label>
          <p class="crew-form__error" id="crew-error" hidden></p>
          <button class="btn btn--primary" type="submit">Send it in</button>
        </form>
        <p class="crew-form__photo-note">Prefer to send a photo? Email it to info@golden-wings-robyn.com after you submit.</p>

        <div class="crew-form__success" id="crew-success" hidden>
          <span class="badge">Received</span>
          <p>Thank you. We read every one. If we use your story we will write to you first.</p>
        </div>
      </div>
    </div>
  </section>


  <section class="section poster-plate full-bleed-home" aria-labelledby="poster-heading">
    <div class="poster-plate__inner">
      <div class="poster-plate__copy">
        <p class="section__label plate--subtitle">The film</p>
        <h2 id="poster-heading" class="section__title">Official poster</h2>
        <p class="poster-plate__lede">Stewardess to Sky Queen. The 2026 poster for Golden Wings.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={posterSrc} download="GWSSQ_Poster_2026.png">Download poster</a>
          <a class="btn btn--ghost" href="/press-kit">Press kit</a>
        </div>
      </div>
      <a class="poster-plate__frame" href={posterSrc} download="GWSSQ_Poster_2026.png" aria-label="Download the official poster">
        <img class="poster-plate__img" src={posterSrc} alt="Official Golden Wings: Stewardess to Sky Queen poster, 2026" width="1083" height="1452" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

    <section class="section" aria-labelledby="story-heading">
    <div class="story-split">
      <div>
        <p class="section__label plate--subtitle">The story</p>
        <h2 id="story-heading" class="section__title">Aviation history, family memory</h2>
        <div class="prose">
      <p>Golden Wings chronicles the evolution of commercial aviation through the life of Robyn Stewart, from the jet age to modern international routes, weaving archival footage, home video, and vérité moments into a portrait of professionalism, resilience, and the stubborn instinct to keep going.</p>
      <p>Shot as a micro-budget student project that grew into an award-winning short, the film has been recognized at festivals including the Swedish International Film Festival, Magic Silver Screen, and Independent Shorts Awards.</p>
    </div>
        <div class="hero__ctas" style="margin-top: 2rem;">
      <a class="btn btn--primary" href="/film">The film</a>
      <a class="btn btn--ghost" href="/indie-doc-journey">Indie Doc Journey</a>
    </div>
      </div>
      <ScreeningsCard />
    </div>
  </section>

  <section id="synthetic-media" class="section synth-note" aria-labelledby="synth-heading">
    <div class="synth-note__inner">
      <p class="section__label plate--subtitle">About the footage</p>
      <h2 id="synth-heading" class="sr-only">About the footage</h2>
      <p>
        Where period footage was lost, Golden Wings reconstructs it with synthetic media and says so on screen. Every person you see in the film is real. Every reconstruction is labelled.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("crew-form");
  const errorEl = document.getElementById("crew-error");
  const successEl = document.getElementById("crew-success");
  const consent = document.getElementById("crew-consent");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !errorEl || !successEl) return;

    errorEl.hidden = true;
    errorEl.textContent = "";

    if (!(consent instanceof HTMLInputElement) || !consent.checked) {
      errorEl.textContent = "Please check the consent box before sending.";
      errorEl.hidden = false;
      consent?.focus();
      return;
    }

    const body = new FormData(form);
    try {
      const res = await fetch("/api/crew", { method: "POST", body });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        errorEl.textContent = data.error || "Something went wrong. Try again.";
        errorEl.hidden = false;
        return;
      }
      form.hidden = true;
      const photoNote = document.querySelector(".crew-form__photo-note");
      if (photoNote instanceof HTMLElement) photoNote.hidden = true;
      successEl.hidden = false;
    } catch {
      errorEl.textContent = "Network error. Try again.";
      errorEl.hidden = false;
    }
  });
</script>
