---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { homeJsonLd } from "../lib/seo";
import robynGrad1971 from "../assets/people/robyn-stewart-1971.jpg";

const description =
  "Golden Wings, a vivid documentary following flight attendant Robyn Stewart's 55-year legacy of resilience, family, and flight, told by her son Caleb.";

const year = new Date().getFullYear();

const posterSrc = "/images/poster/GWSSQ_Poster_2026.png";

const collegePoster =
  "/images/archive/GW50YFP_still_Stewardess_College_Footage_1968.png";
const collegeVideo = "/videos/archive/stewardess-college-1968.mp4";
const collegeMediaAlt =
  "Restored 1968 archival footage from American Airlines Stewardess College training in Fort Worth";

const laurels = [
  {
    src: "/images/laurels/Laurel_BEST_MOBILE_SHORT_-_Independent_Shorts_Awards_-_2024.png",
    alt: "Independent Shorts Awards - Best Mobile Short",
  },
  {
    src: "/images/laurels/Laurel_BEST_SHORT_CINEMATOGRAPHY_SILICON_BEACH.png",
    alt: "Silicon Beach Film Festival - Best Short Cinematography",
  },
  {
    src: "/images/laurels/Laurel_MAGIC_FANCY_DIRECTOR.png",
    alt: "Magic Silver Screen - Best First Time Director",
  },
  {
    src: "/images/laurels/MAGIC_FANCY_DOC.png",
    alt: "Magic Silver Screen - Best Documentary Short",
  },
  {
    src: "/images/laurels/BEST_DOCUMENTARY_SHORT_-_IGFA_-_International_Guadalajara_Film_Awards_-_2024.png",
    alt: "IGFA International Guadalajara Film Awards - Best Documentary Short",
  },
];
---

<BaseLayout title="Golden Wings" description={description} jsonLd={homeJsonLd(description)}>
  <section class="hero full-bleed-home" aria-label="Golden Wings">
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/synth-media/747-synth-broll-reel-poster.jpg"
      >
        <source
          src="/videos/synth-media/747-synth-broll-reel.mp4"
          type="video/mp4"
        />
      </video>
      <img
        class="hero__poster"
        src="/images/synth-media/747-synth-broll-reel-poster.jpg"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content">
      <p class="hero__brand-mark">
        <img
          src="/images/title-logo.png"
          alt="Golden Wings"
          width="900"
          height="360"
        />
      </p>
      <p class="script hero__motto">Find Your Wings</p>
      <h1 class="hero__headline">
        <span class="hero__headline-line"
          >1971: Robyn meets Destiny onboard the 747.</span
        >
        <span class="hero__headline-line"
          >{year}: Still flying. Now with golden wings.</span
        >
      </h1>
      <p class="hero__lede">
        1982. Flight engineer Jay Ricks: final 747 to Hawaii. His daughter Robyn Stewart: flying since 1971. A two-year-old grandson on board: the director.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/people">Meet the people</a>
        <a class="btn btn--ghost" href="/about-the-film">About the film</a>
      </div>
    </div>
    <div class="hero__laurels award-strip" aria-label="Festival wins">
      {
        laurels.map((laurel) => (
          <img src={laurel.src} alt={laurel.alt} width="320" height="210" loading="lazy" />
        ))
      }
    </div>
    <div class="hero__wing" aria-hidden="true"></div>
  </section>

  <section
    class="section archive-plate full-bleed-home"
    aria-labelledby="college-heading"
  >
    <div class="archive-plate__inner">
      <div class="archive-plate__copy">
        <p class="section__label plate--subtitle">Archive · 1968</p>
        <h2 id="college-heading" class="section__title">
          American Airlines Stewardess College
        </h2>
        <p class="archive-plate__lede">
          Robyn's training world: weight checks, girdle rules, the machine that
          made cabin crews. Shown through restored college footage.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--ghost" href="/stewardess-college-1968"
            >Archive page</a
          >
        </div>
      </div>
      <div class="archive-plate__frame">
        <div class="archive-plate__media">
          <video
            class="archive-plate__video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={collegePoster}
            aria-label={collegeMediaAlt}
          >
            <source src={collegeVideo} type="video/mp4" />
          </video>
          <img
            class="archive-plate__poster"
            src={collegePoster}
            alt={collegeMediaAlt}
            width="1635"
            height="925"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section
    class="section graduation-plate"
    aria-labelledby="grad-heading"
  >
    <div class="graduation-plate__inner">
      <div class="graduation-plate__copy">
        <p class="section__label plate--subtitle">Archive · 1971</p>
        <h2 id="grad-heading" class="section__title">Graduation day</h2>
        <p class="graduation-plate__lede">
          Robyn Stewart at American Airlines Stewardess College graduation in
          1971, with her parents Jay and Marie Ricks.
        </p>
      </div>
      <figure class="graduation-plate__frame">
        <Image
          class="graduation-plate__img"
          src={robynGrad1971}
          alt="Robyn Stewart in uniform at her 1971 American Airlines Stewardess College graduation, standing between her parents Jay and Marie Ricks"
          widths={[480, 720, 960]}
          sizes="(min-width: 860px) 22rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section poster-plate full-bleed-home" aria-labelledby="poster-heading">
    <div class="poster-plate__inner">
      <div class="poster-plate__copy">
        <p class="section__label plate--subtitle">The film</p>
        <h2 id="poster-heading" class="section__title">Official poster</h2>
        <p class="poster-plate__lede">
          Stewardess to Sky Queen. The 2026 poster for Golden Wings.
        </p>
        <div class="hero__ctas">
          <a
            class="btn btn--primary"
            href={posterSrc}
            download="GWSSQ_Poster_2026.png"
            >Download poster</a
          >
          <a class="btn btn--ghost" href="/film">About the film</a>
        </div>
      </div>
      <a
        class="poster-plate__frame"
        href={posterSrc}
        download="GWSSQ_Poster_2026.png"
        aria-label="Download the official Golden Wings Stewardess to Sky Queen poster"
      >
        <img
          class="poster-plate__img"
          src={posterSrc}
          alt="Official Golden Wings: Stewardess to Sky Queen poster, 2026"
          width="1083"
          height="1452"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <section class="section" aria-labelledby="story-heading">
    <p class="section__label plate--subtitle">The story</p>
    <h2 id="story-heading" class="section__title">Aviation history, family memory</h2>
    <div class="prose">
      <p>
        Golden Wings chronicles the evolution of commercial aviation through the
        life of Robyn Stewart, from the jet age to modern international routes,
        weaving archival footage, home video, and vérité moments into a portrait
        of professionalism, resilience, and the stubborn instinct to keep going.
      </p>
      <p>
        Shot as a micro-budget student project that grew into an award-winning
        short, the film has been recognized at festivals including the Swedish
        International Film Festival, Magic Silver Screen, and Independent Shorts
        Awards.
      </p>
    </div>
    <div class="hero__ctas" style="margin-top: 2rem;">
      <a class="btn btn--primary" href="/film">The film</a>
      <a class="btn btn--ghost" href="/indie-doc-journey">Indie Doc Journey</a>
    </div>
  </section>

  <section class="section" aria-labelledby="awards-heading">
    <p class="section__label plate--subtitle">Recognition</p>
    <h2 id="awards-heading" class="section__title">Selected awards</h2>
    <ul class="prose">
      <li>NewsFest: Most Outstanding / Most Inspiring / Best Trailer</li>
      <li>Swedish International Film Festival (2025): Best Documentary (Short)</li>
      <li>Independent Shorts Awards: Best Mobile Short</li>
      <li>Magic Silver Screen: Best Short Documentary + Best First-Time Director</li>
      <li>IGFA Guadalajara: Best Documentary Short</li>
      <li>Silicon Beach Film Festival: Best Short Cinematography</li>
    </ul>
  </section>
</BaseLayout>
