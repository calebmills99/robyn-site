---
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "From girdle checks at stewardess college to golden wings after fifty years in the cabin, one American Airlines family carries the 747 rollout, 9/11, sobriety, and loss across three generations.";

const logline =
  "From girdle checks at stewardess college to golden wings after fifty years in the cabin, one American Airlines family carries the 747 rollout, 9/11, sobriety, and loss across three generations.";
---

<BaseLayout title="Golden Wings" description={description} home>
  <!-- HERO: Rule Two — 747 / golden age first -->
  <section class="home-hero" aria-label="Golden Wings">
    <div class="home-hero__media" aria-hidden="true">
      <img
        src="/images/boeing747.png"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </div>
    <div class="home-hero__veil" aria-hidden="true"></div>
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">A documentary</p>
      <h1 class="home-hero__title">
        <span class="home-hero__brand">Golden Wings</span>
        <span class="home-hero__subtitle">Fifty Year Flight Path</span>
      </h1>
      <p class="home-hero__lede">
        The golden age of air travel, the Boeing 747, and the cabin crews who
        kept the aisles moving.
      </p>
      <div class="home-hero__ctas">
        <a class="btn btn--primary" href="https://gwingz.com" rel="noopener noreferrer"
          >Watch</a
        >
        <a class="btn btn--ghost" href="#story">The story</a>
      </div>
    </div>
  </section>

  <!-- Cite strip: FA / stewardess memoir framing -->
  <section class="cite-strip" aria-label="About this film">
    <p class="cite-strip__text">
      A documentary about flight attendants. A stewardess family memoir. Not a
      museum piece about airplanes.
    </p>
  </section>

  <!-- Story -->
  <section class="section section--story" id="story" aria-labelledby="story-heading">
    <div class="section__grid">
      <div class="section__copy">
        <p class="section__label">The story</p>
        <h2 id="story-heading" class="section__title">Cabin service since 1971</h2>
        <div class="prose">
          <p>
            Robyn Stewart joined American Airlines as a stewardess in 1971. She
            trained on the 747 and kept flying through the years that remade the
            job: weight checks, mergers, 9/11, and the long haul after.
          </p>
          <p>
            Her father, Jay R. Ricks, was an American Airlines flight engineer
            who helped build the airline's 747 training program. Jock Bethune,
            an AA media production specialist, appears on camera to remember that
            era from the hangar floor, not the cockpit.
          </p>
          <p>
            Directed by Robyn's son, Caleb Mills Stewart, the film stays with
            one family across three generations of American Airlines service.
          </p>
        </div>
      </div>
      <figure class="section__figure">
        <img
          src="/images/headshots/Jay_R_Ricks_and_Robyn2014.jpg"
          alt="Jay R. Ricks and Robyn Stewart with their dog, 2014"
          width="890"
          height="960"
          loading="lazy"
        />
        <figcaption>Jay R. Ricks and Robyn Stewart, 2014</figcaption>
      </figure>
    </div>
  </section>

  <!-- Festival / Press -->
  <section class="section section--press" id="press" aria-labelledby="press-heading">
    <p class="section__label">Festival &amp; press</p>
    <h2 id="press-heading" class="section__title">On the circuit</h2>
    <blockquote class="logline">
      <p>{logline}</p>
    </blockquote>
    <ul class="spec-list">
      <li>Short documentary</li>
      <li>Directed by Caleb Mills Stewart</li>
      <li>Subject: Robyn Stewart, American Airlines flight attendant since 1971</li>
      <li>Swedish International Film Festival (2025): Best Documentary (Short)</li>
      <li>Clown International Film Festival: Best Documentary Short</li>
      <li>Independent Shorts Awards: Best Mobile Short</li>
      <li>Silicon Beach Film Festival: Best Short Cinematography</li>
    </ul>
  </section>

  <!-- People: approved color headshots only -->
  <section class="section section--people" id="people" aria-labelledby="people-heading">
    <p class="section__label">People</p>
    <h2 id="people-heading" class="section__title">Who you'll meet</h2>
    <ul class="people-row">
      <li>
        <article class="person-tile">
          <img
            class="person-tile__img"
            src="/images/headshots/RobynHeadshot_TealOrangeBG_upscale.jpg"
            alt="Robyn Stewart smiling in a colorful jacket"
            width="663"
            height="960"
            loading="lazy"
          />
          <h3 class="person-tile__name">Robyn Stewart</h3>
          <p class="person-tile__role">Flight attendant</p>
          <p class="person-tile__bio">
            American Airlines cabin crew since 1971. The reason this film exists.
          </p>
        </article>
      </li>
      <li>
        <article class="person-tile">
          <img
            class="person-tile__img"
            src="/images/headshots/Caleb_Exec_Square.png"
            alt="Caleb Mills Stewart, director"
            width="1200"
            height="1200"
            loading="lazy"
          />
          <h3 class="person-tile__name">Caleb Mills Stewart</h3>
          <p class="person-tile__role">Director</p>
          <p class="person-tile__bio">
            Robyn's son. Los Angeles filmmaker. Made the film for an audience of one.
          </p>
        </article>
      </li>
      <li>
        <article class="person-tile person-tile--text">
          <h3 class="person-tile__name">Jock Bethune</h3>
          <p class="person-tile__role">On camera</p>
          <p class="person-tile__bio">
            American Airlines media production specialist. His department made
            training slides for Jay Ricks' 747 ground school. He tells that story
            on camera.
          </p>
        </article>
      </li>
    </ul>
    <p class="section__more">
      <a href="/people">More people</a>
    </p>
  </section>

  <!-- Watch placeholder: no stock trailer still -->
  <section class="section section--watch" id="watch" aria-labelledby="watch-heading">
    <p class="section__label">Watch</p>
    <h2 id="watch-heading" class="section__title">See the film</h2>
    <p class="section__lede">
      Screenings and digital access live on gwingz.com.
    </p>
    <a class="btn btn--primary" href="https://gwingz.com" rel="noopener noreferrer"
      >Watch on gwingz.com</a
    >
  </section>

  <!-- Contact band -->
  <section class="section section--contact" id="contact" aria-labelledby="contact-heading">
    <p class="section__label">Contact</p>
    <h2 id="contact-heading" class="section__title">Press &amp; festivals</h2>
    <p class="section__lede">
      Reach the filmmaker or the production inbox.
    </p>
    <ul class="contact-list">
      <li>
        <a href="mailto:caleb@golden-wings-robyn.com">caleb@golden-wings-robyn.com</a>
      </li>
      <li>
        <a href="mailto:info@golden-wings-robyn.com">info@golden-wings-robyn.com</a>
      </li>
    </ul>
  </section>
</BaseLayout>
