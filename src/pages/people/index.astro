---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo";

const people = (await getCollection("people")).sort(
  (a, b) => a.data.order - b.data.order,
);

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter((word) => /^[A-Z]/.test(word))
    .map((word) => word[0])
    .slice(0, 2)
    .join("");
}

const description =
  "The people of Golden Wings: flight attendant Robyn Stewart, her father Jay R. Ricks, Jock Bethune, Millie Alford, and director Caleb Mills Stewart.";

const jsonLd = collectionPageJsonLd({
  name: "People",
  description,
  url: "/people",
  items: people.map((person) => ({
    name: person.data.name,
    url: `/people/${person.id}`,
    description: person.data.description || person.data.lede,
  })),
});
---

<BaseLayout title="People" description={description} jsonLd={jsonLd}>
  <p class="section__label plate--subtitle">Golden Wings</p>
  <h1 class="section__title">People</h1>
  <p class="prose">
    Golden Wings follows one American Airlines family across three generations:
    Robyn Stewart, her father Jay R. Ricks, Jock Bethune, Millie Alford, and
    Robyn's son, director Caleb Mills Stewart.
  </p>
  <ul class="people-grid">
    {
      people.map((person) => (
        <li>
          <a class="people-card" href={`/people/${person.id}`}>
            {person.data.portrait ? (
              <Image
                class="people-card__img"
                src={person.data.portrait}
                alt={person.data.portraitAlt ?? ""}
                widths={[240, 480]}
                sizes="(max-width: 720px) 90vw, 16rem"
              />
            ) : (
              <span class="people-card__img people-card__img--empty" aria-hidden="true">
                {initials(person.data.name)}
              </span>
            )}
            <span class="people-card__role">{person.data.role}</span>
            <h2 class="people-card__name">{person.data.name}</h2>
            <p class="people-card__lede">{person.data.lede}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
