---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "terms-of-use");
if (!entry) throw new Error("Missing content: pages/terms-of-use");
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description || "Terms of Use for Golden Wings."}
>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
