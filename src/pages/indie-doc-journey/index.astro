---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Indie Doc Journey"
  description="Behind-the-scenes notes from making Golden Wings — festival strategy, craft, and the indie documentary grind."
>
  <p class="section__label">Companion blog</p>
  <h1 class="section__title">Indie Doc Journey</h1>
  <p class="prose" style="margin-bottom: 2rem;">
    Festival lessons, craft notes, and the long road of an independent aviation
    documentary.
  </p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/indie-doc-journey/${post.id}`}>
            <h2 class="post-list__title">{post.data.title}</h2>
            {post.data.description && (
              <p class="post-list__desc">{post.data.description}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
