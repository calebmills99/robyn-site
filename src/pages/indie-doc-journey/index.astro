---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo";

function displayTitle(raw: string) {
  return String(raw)
    .replace(/\s*\(Copy\)\s*$/i, "")
    .replace(/Golden Wings:\s*(Fifty|50)\s*Year\s*Flight\s*Path/gi, "Golden Wings")
    .replace(/\b(Fifty|50)\s*Year\s*Flight\s*Path\b/gi, "Golden Wings")
    .trim();
}

const posts = (await getCollection("blog")).sort((a, b) =>
  displayTitle(a.data.title).localeCompare(displayTitle(b.data.title)),
);

const description =
  "Behind-the-scenes notes from making Golden Wings - festival strategy, craft, and the indie documentary grind.";

const jsonLd = collectionPageJsonLd({
  name: "Indie Doc Journey",
  description,
  url: "/indie-doc-journey",
  items: posts.map((post) => ({
    name: displayTitle(post.data.title),
    url: `/indie-doc-journey/${post.id}`,
    description: post.data.description || undefined,
  })),
});
---

<BaseLayout
  title="Indie Doc Journey"
  description={description}
  jsonLd={jsonLd}
>
  <p class="section__label plate--subtitle">Companion blog</p>
  <h1 class="section__title">Indie Doc Journey</h1>
  <p class="script page-motto">Find Your Wings</p>
  <p class="prose" style="margin-bottom: 2rem;">
    Festival lessons, craft notes, and the long road of an independent aviation
    documentary.
  </p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/indie-doc-journey/${post.id}`}>
            <h2 class="post-list__title">{displayTitle(post.data.title)}</h2>
            {post.data.description && (
              <p class="post-list__desc">{post.data.description}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
