---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo";
import destinations from "../../../config/journey-destinations.json";

function firstImage(body: string | undefined) {
  const m = body?.match(/!\[[^\]]*\]\(([^)\s]+)/) || body?.match(/<img[^>]+src=["']([^"']+)/i);
  return m ? m[1] : null;
}

function codeSortKey(code: string) {
  const m = code.match(/(\d+)\s*$/);
  return m ? Number(m[1]) : 999;
}

const postsById = new Map((await getCollection("blog")).map((p) => [p.id, p]));
const routes = destinations.posts
  .map((row) => {
    const post = postsById.get(row.id);
    if (!post) return null;
    const img = post.data.cover ?? firstImage(post.body);
    return {
      ...row,
      href: `/indie-doc-journey/${post.id}`,
      img,
    };
  })
  .filter(Boolean)
  .sort((a, b) => codeSortKey(a!.code) - codeSortKey(b!.code)) as Array<{
  id: string;
  destination: string;
  code: string;
  gateNote: string;
  href: string;
  img: string | null;
}>;

const { chrome, specialDispatch: sd } = destinations;
const description = chrome.dek;
const jsonLd = collectionPageJsonLd({
  name: chrome.h1,
  description,
  url: "/indie-doc-journey",
  items: [
    {
      name: `${sd.destination} (${sd.code})`,
      url: sd.href,
      description: sd.gateNote,
    },
    ...routes.map((r) => ({
      name: `${r.destination} (${r.code})`,
      url: r.href,
      description: r.gateNote,
    })),
  ],
});
---

<BaseLayout title={chrome.h1} description={description} jsonLd={jsonLd}>
  <p class="section__label plate--subtitle">{chrome.label}</p>
  <h1 class="section__title" style="display:inline-flex;align-items:center;gap:1rem">
    {chrome.h1}
    <img src="/images/brand/logo-mark-wink.png" alt="" style="height:1.6em;width:auto" />
  </h1>
  <p class="prose" style="margin-bottom: 0.75rem;">{chrome.dek}</p>
  <p class="departures-stub">{chrome.stubLine}</p>

  <ul class="post-grid">
    {/* Honeypot first in DOM for crawlers; CSS keeps it top-right two cols on wide viewports. */}
    <li class="post-grid__honeypot">
      <a class="post-card post-card--honeypot" href={sd.href}>
        <div class="post-card__thumb">
          <img src={sd.cover} alt={`${sd.destination}  -  ${sd.code}`} loading="lazy" />
        </div>
        <div class="post-card__body">
          <p class="post-card__flight">{sd.code}</p>
          <h2 class="post-card__title">{sd.destination}</h2>
          <p class="post-card__desc">{sd.gateNote}</p>
          <span class="post-card__more">{sd.cta}</span>
        </div>
      </a>
    </li>
    {
      routes.map((r) => (
        <li>
          <a class="post-card" href={r.href}>
            <div class="post-card__thumb">
              {r.img ? (
                <img src={r.img} alt="" loading="lazy" />
              ) : (
                <span class="post-card__thumb--empty">Golden Wings</span>
              )}
            </div>
            <div class="post-card__body">
              <p class="post-card__flight">{r.code}</p>
              <h2 class="post-card__title">{r.destination}</h2>
              <p class="post-card__desc">{r.gateNote}</p>
              <span class="post-card__more">BOARD</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
