---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo";

function displayTitle(raw: string) {
  return String(raw)
    .replace(/\s*\(Copy\)\s*$/i, "")
    .replace(/Golden Wings:\s*(Fifty|50)\s*Year\s*Flight\s*Path/gi, "Golden Wings")
    .replace(/\b(Fifty|50)\s*Year\s*Flight\s*Path\b/gi, "Golden Wings")
    .trim();
}
/** First image in the post body, if any, for the card thumbnail. */
function firstImage(body: string | undefined) {
  const m = body?.match(/!\[[^\]]*\]\(([^)\s]+)/) || body?.match(/<img[^>]+src=["']([^"']+)/i);
  return m ? m[1] : null;
}

const FILTERS = ["All", "Festivals", "Craft", "People", "Special Dispatch", "From the Galley"] as const;

const posts = (await getCollection("blog")).sort((a, b) =>
  displayTitle(a.data.title).localeCompare(displayTitle(b.data.title)),
);
const description =
  "Behind-the-scenes notes from making Golden Wings - festival strategy, craft, and the indie documentary grind.";
const jsonLd = collectionPageJsonLd({
  name: "Indie Doc Journey", description, url: "/indie-doc-journey",
  items: [
    { name: "Special Dispatch № 01: Banned on Christmas Eve", url: "/special-dispatch/facebook-banned-on-christmas-eve/", description: "Christmas Eve ban survival map, smoking gun, and Meta small-claims win." },
    ...posts.map((post) => ({ name: displayTitle(post.data.title), url: `/indie-doc-journey/${post.id}`, description: post.data.description || undefined })),
  ],
});
---

<BaseLayout title="Indie Doc Journey" description={description} jsonLd={jsonLd}>
  <p class="section__label plate--subtitle">Companion blog</p>
  <h1 class="section__title" style="display:inline-flex;align-items:center;gap:1rem">Indie Doc Journey <img src="/images/brand/logo-mark-wink.png" alt="" style="height:1.6em;width:auto" /></h1>
  <p class="prose" style="margin-bottom: 1.5rem;">Festival lessons, craft notes, and the long road of an independent aviation documentary.</p>

  <div class="journey-filters" role="toolbar" aria-label="Filter posts by tag">
    {FILTERS.map((tag, i) => (
      <button
        type="button"
        class:list={["journey-filters__btn", i === 0 && "is-active"]}
        data-filter={tag}
      >{tag}</button>
    ))}
  </div>

  <ul class="post-grid" id="journey-grid">
    <li data-tags="Special Dispatch">
      <a class="post-card" href="/special-dispatch/facebook-banned-on-christmas-eve/">
        <div class="post-card__thumb"><span class="post-card__thumb--empty">Special Dispatch</span></div>
        <div class="post-card__body">
          <span class="badge" style="background:var(--gw-red);border-color:var(--gw-red);color:var(--gw-cream)">Special Dispatch № 01</span>
          <h2 class="post-card__title">Banned on Christmas Eve</h2>
          <p class="post-card__desc">Survival map, smoking gun, and the Meta small-claims win. With a magazine PDF download.</p>
          <span class="post-card__more">Read →</span>
        </div>
      </a>
    </li>
    {posts.map((post) => {
      const img = firstImage(post.body);
      const tags = post.data.tags ?? [];
      const isGalley = tags.includes("From the Galley");
      return (
      <li data-tags={tags.join("|") || "All"}>
        <a class="post-card" href={`/indie-doc-journey/${post.id}`}>
          <div class="post-card__thumb">{img ? <img src={img} alt="" loading="lazy" /> : <span class="post-card__thumb--empty">Golden Wings</span>}</div>
          <div class="post-card__body">
            {isGalley && (
              <span class="badge" style="background:var(--gw-red);border-color:var(--gw-red);color:var(--gw-cream)">From the Galley</span>
            )}
            <h2 class="post-card__title">{displayTitle(post.data.title)}</h2>
            {post.data.description && <p class="post-card__desc">{post.data.description}</p>}
            <span class="post-card__more">Read →</span>
          </div>
        </a>
      </li>
    ); })}
  </ul>

  <aside class="journey-share" aria-labelledby="journey-share-heading">
    <h2 id="journey-share-heading" class="section__title">Have one of your own?</h2>
    <p class="prose" style="margin:0;">Former crew stories land here under From the Galley — with your name and airline, after we write to you first.</p>
    <a class="btn btn--ghost" href="/#crew">Share your story</a>
  </aside>
</BaseLayout>

<script>
  const toolbar = document.querySelector(".journey-filters");
  const grid = document.getElementById("journey-grid");
  toolbar?.addEventListener("click", (event) => {
    const btn = event.target instanceof Element ? event.target.closest("button[data-filter]") : null;
    if (!btn || !grid) return;
    const filter = btn.getAttribute("data-filter") || "All";
    toolbar.querySelectorAll(".journey-filters__btn").forEach((el) => {
      el.classList.toggle("is-active", el === btn);
    });
    grid.querySelectorAll(":scope > li").forEach((li) => {
      const tags = (li.getAttribute("data-tags") || "").split("|").filter(Boolean);
      const show = filter === "All" || tags.includes(filter);
      li.hidden = !show;
    });
  });
</script>
