---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo";

function displayTitle(raw: string) {
  return String(raw)
    .replace(/\s*\(Copy\)\s*$/i, "")
    .replace(/Golden Wings:\s*(Fifty|50)\s*Year\s*Flight\s*Path/gi, "Golden Wings")
    .replace(/\b(Fifty|50)\s*Year\s*Flight\s*Path\b/gi, "Golden Wings")
    .trim();
}

const posts = (await getCollection("blog")).sort((a, b) =>
  displayTitle(a.data.title).localeCompare(displayTitle(b.data.title)),
);

const description =
  "Behind-the-scenes notes from making Golden Wings - festival strategy, craft, and the indie documentary grind.";

const jsonLd = collectionPageJsonLd({
  name: "Indie Doc Journey",
  description,
  url: "/indie-doc-journey",
  items: [
    {
      name: "Special Dispatch № 01: Banned on Christmas Eve",
      url: "/special-dispatch/facebook-banned-on-christmas-eve/",
      description:
        "Christmas Eve ban survival map, smoking gun, and Meta small-claims win.",
    },
    ...posts.map((post) => ({
      name: displayTitle(post.data.title),
      url: `/indie-doc-journey/${post.id}`,
      description: post.data.description || undefined,
    })),
  ],
});
---

<BaseLayout
  title="Indie Doc Journey"
  description={description}
  jsonLd={jsonLd}
>
  <p class="section__label plate--subtitle">Companion blog</p>
  <h1 class="section__title">Indie Doc Journey</h1>
  <p class="script page-motto">Find Your Wings</p>
  <p class="prose" style="margin-bottom: 2rem;">
    Festival lessons, craft notes, and the long road of an independent aviation
    documentary.
  </p>

  <section class="section" style="padding-block: 0 2rem;" aria-labelledby="special-dispatch-heading">
    <p class="section__label plate--subtitle">Special Dispatch</p>
    <h2 class="section__title" id="special-dispatch-heading">
      Banned on Christmas Eve
    </h2>
    <p class="prose" style="margin-bottom: 1.25rem;">
      Indie Doc Journey · Special Dispatch № 01. Hub plus Part 1 survival map,
      with a magazine PDF download. Part 2 stays on Journey for now.
    </p>
    <div class="hero__ctas">
      <a
        class="btn btn--primary"
        href="/special-dispatch/facebook-banned-on-christmas-eve/"
        >Read Special Dispatch № 01</a
      >
      <a class="btn btn--ghost" href="/special-dispatch/">All Special Dispatches</a>
    </div>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/indie-doc-journey/${post.id}`}>
            <h2 class="post-list__title">{displayTitle(post.data.title)}</h2>
            {post.data.description && (
              <p class="post-list__desc">{post.data.description}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
