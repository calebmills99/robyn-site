{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden Wings watch page config",
  "type": "object",
  "required": ["slug", "path", "title", "description", "h1", "video"],
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^/" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "h1": { "type": "string" },
    "eyebrow": { "type": "string" },
    "body": { "type": "string" },
    "video": {
      "type": "object",
      "required": ["contentUrl", "posterUrl", "mediaAlt", "uploadDate", "name"],
      "properties": {
        "contentUrl": { "type": "string", "description": "Stable MP4/WebM path under public/" },
        "posterUrl": { "type": "string", "description": "Stable poster/thumbnail URL" },
        "mediaAlt": { "type": "string" },
        "uploadDate": { "type": "string", "description": "ISO 8601 date or datetime" },
        "duration": { "type": "string", "description": "ISO 8601 duration, e.g. PT1M54S" },
        "name": { "type": "string" },
        "autoplay": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "controls": { "type": "boolean" }
      }
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "style": { "type": "string", "enum": ["primary", "ghost"] }
        }
      }
    },
    "noWatchFilmCta": { "type": "boolean", "const": true }
  }
}
